#!/bin/bash
set -eE -o pipefail

# Default settings
SOURCE_DIR="sources"
TMP_DIR="tmp"
DOWNLOADS_DIR="downloads"
OUTPUT_DIR="output"

COLOR_MODE=("foreground" "background")
PAPER_ORIENTATION=("portrait" "landscape")

# Load custom settings
ENV_FILE="$(basename "$0").env"
[ -e "$ENV_FILE" ] && source "$ENV_FILE"

mkdir -p "$SOURCE_DIR" "$TMP_DIR" "$DOWNLOADS_DIR" "$OUTPUT_DIR"



##
# Utility functions
# Source - https://stackoverflow.com/a/29613573
# Posted by mklement0, modified by community. See post 'Timeline' for change history
# Retrieved 2026-10-01, License - CC BY-SA 4.0
##

# Quote `sed` regular expressions for further use
quoteRe() {
	[ $# -ne 1 ] && echo "Usage: $0 REGULAR_EXPRESSION"
	echo "$1" | sed -e 's/[^^]/[&]/g; s/\^/\\^/g; $!a\'$'\n''\\n' | tr -d '\n'
}

# Quote `sed` substitutions for further use
quoteSubst() {
	[ $# -ne 1 ] && echo "Usage: $0 SUBSTITUTION_STRING"
	IFS= read -d '' -r < <(echo "$1" | sed -e ':a' -e '$!{N;ba' -e '}' -e 's/[&/\]/\\&/g; s/\n/\\&/g')
	printf %s "${REPLY%$'\n'}"
}



##
# Functions for the various steps
##

# Check if all necessary tools are available
check_tools() {
	if [ -n "$VIRTUALENV_TO_USE" ] && [ -z "$VIRTUAL_ENV" ]; then
		source "/usr/share/virtualenvwrapper/virtualenvwrapper.sh"
		if ! grep -e '^'"$VIRTUALENV_TO_USE"'$' <(lsvirtualenv); then
			mkvirtualenv "$VIRTUALENV_TO_USE"
		fi
		workon "$VIRTUALENV_TO_USE"
	fi
	for tool in \
		csvcut \
		csvformat \
		csvgrep \
		ics2rem \
		qpdf \
		rem2pdf \
		remind \
		sed \
		wget \
	; do
		which "$tool"
	done
}


# Download .ics files
download_icals() {
	csvcut -t -c 'Calendrier,URL' "$SOURCE_DIR/$SOURCE_FILEROOT.tsv" | csvformat -T -E \
		| while IFS=$'\t' read calendrier url; do
		if [ -z "$url" ]; then
			rm "$DOWNLOADS_DIR/$calendrier.ics" || true
		else
			wget "$url" -O "$DOWNLOADS_DIR/$calendrier.ics"
		fi
	done
}


# Make PDF files (results)
generate_pdfs() {
	while read reminders_file; do
		oldest_date="$(get_oldest_date_in_rem "$reminders_file")"
		oldest_date="${oldest_date%-*}-01"
		if [ "${oldest_date//-/}" -lt "19900101" ]; then
			oldest_date="1990-01-01"
		fi
		months_since="$(months_since_date "$oldest_date")"
		months="$((months_since+1+12))"

		# Defaults match rem2pdf's
		params=(
			"--media=${PAPER_SIZE:-A4}"
			"--margin-top=${MARGIN_TOP:-14}"
			"--margin-bottom=${MARGIN_BOTTOM:-14}"
			"--margin-left=${MARGIN_LEFT:-28}"
			"--margin-right=${MARGIN_RIGHT:-28}"
			"--title-font=${TITLE_FONT:-Sans}"
			"--header-font=${HEADER_FONT:-Sans}"
			"--daynum-font=${DAYNUM_FONT:-Sans Bold Oblique}"
			"--entry-font=${ENTRY_FONT:-Sans}"
			"--small-cal-font=${SMALL_CAL_FONT:-Sans}"
			"--title-size=${TITLE_SIZE:-14}"
			"--header-size=${HEADER_SIZE:-14}"
			"--daynum-size=${DAYNUM_SIZE:-14}"
			"--entry-size=${ENTRY_SIZE:-8}"
			"--title-color=${TITLE_COLOR:-000000}"
			"--header-color=${HEADER_COLOR:-000000}"
			"--daynum-color=${DAYNUM_COLOR:-000000}"
			"--border-size=${BORDER_SIZE:-4}"
			"--entry-spacing=${ENTRY_SPACING:-2}"
			"--line-thickness=${LINE_THICKNESS:-1}"
			"--line-color=${LINE_COLOR:-000000}"
		)
		if [ "$AVOID_OVERFULL" ]; then
			params+=("--avoid-overfull")
		fi

		for paper_orientation in "${PAPER_ORIENTATION[@]}"; do
			exec_params=("${params[@]}")
			case "$paper_orientation" in
				"landscape")
					exec_params+=("--$paper_orientation")
					;;
				"portrait")
					;;
				*)
					echo "Unknown paper orientation: '$paper_orientation'. Assuming 'portrait'." >&2
					;;
			esac
			remind -b1 -m -ppp"$months" "$reminders_file" "$oldest_date" \
				| tee "$reminders_file.json" \
				| rem2pdf "${exec_params[@]}" \
				> "$reminders_file.$paper_orientation.pdf.tmp"
			qpdf --empty --pages "$reminders_file.$paper_orientation.pdf.tmp" r14-r1 -- "$reminders_file.$paper_orientation.pdf"
			rm "$reminders_file.$paper_orientation.pdf.tmp"
			mv "$reminders_file.$paper_orientation.pdf" "$OUTPUT_DIR/"
		done
	done
}


# Generate data in Remind format from source and downloaded files
generate_rems() {
	csvcut -t -c 'Catégorie,Calendrier,Couleur,Gras,Italique' "$SOURCE_DIR/$SOURCE_FILEROOT.tsv" | csvformat -T -E \
		| while IFS=$'\t' read categorie calendrier couleur gras italique; do
		tag="${calendrier//[ ,]/_}"
		if [ "${categorie:0:1}" == "*" ]; then
			tag='_'
		fi
		if [ -e "$DOWNLOADS_DIR/$calendrier.ics" ]; then
			echo "# < $DOWNLOADS_DIR/$calendrier.ics"
			ics2rem --no-locations -t "$tag" "$DOWNLOADS_DIR/$calendrier.ics"
			echo "# /< $DOWNLOADS_DIR/$calendrier.ics"
			echo
		else
			echo "# < $SOURCE_DIR/$calendrier.rem"
			cat "$SOURCE_DIR/$calendrier.rem"
			echo "# /< $SOURCE_DIR/$calendrier.rem"
			echo
		fi \
			> "$TMP_DIR/$calendrier.ics.rem"
		for color_mode in "${COLOR_MODE[@]}"; do
			pango_before=""
			if [ -n "$couleur" ]; then
				pango_before+="<span $color_mode="'"'"$couleur"
				case "$color_mode" in
					background)
						pango_before+='20">'
						;;
					foreground)
						pango_before+='FF">'
						;;
				esac
			fi
			if [ "$gras" == "true" ]; then
				pango_before+="<b>"
			fi
			if [ "$italique" == "true" ]; then
				pango_before+="<i>"
			fi
			pango_after=""
			if [ "$italique" == "true" ]; then
				pango_after+="</i>"
			fi
			if [ "$gras" == "true" ]; then
				pango_after+="</b>"
			fi
			if [ -n "$couleur" ]; then
				pango_after+="</span>"
			fi
			timecode='[iif(trigeventduration() == -1, "", iif(datepart(trigeventstart()) == today(), timepart(trigeventstart()), "") + iif(coerce("INT", trigeventduration()) <= 0, "", "-" + iif((coerce("INT", trigeventstart()) + coerce("INT", trigeventduration())) / 60 / 24 == coerce("INT", today()), timepart(trigeventstart() + trigeventduration()), ""))) + "%_⁠ ⁠"]'
			if [ "$tag" == '_' ]; then
				sed \
					-e 's/^REM \(.*\)\( UNTIL .*\|\) TAG '"$(quoteRe "$tag")"' MSG \(.*\)/# \3\nREM \1\2 '"$(quoteSubst 'SATISFY [($Tw != 6) && ($Tw != 0) && (! isomitted($T))] SPECIAL SHADE [SchoolHolidayShade]')"'/'
			else
				sed \
					-e 's/ TAG '"$(quoteRe "$tag")"' MSG %"\(.*\)%".*/ SPECIAL PANGO '"$(quoteSubst "$timecode$pango_before")"'\1'"$(quoteSubst "$pango_after")"'/' \
					-e 's/ TAG '"$(quoteRe "$tag")"' MSG \(.*\)/ SPECIAL PANGO '"$(quoteSubst "$timecode$pango_before")"'\1'"$(quoteSubst "$pango_after")"'/'
			fi \
				< "$TMP_DIR/$calendrier.ics.rem" \
				> "$TMP_DIR/$calendrier.ics.pango-$color_mode.rem"
		done
	done

	# Concatenate all
	( csvcut -t -c 'Catégorie' "$SOURCE_DIR/$SOURCE_FILEROOT.tsv"; echo '' ) | csvformat -T -E | sed -e '/^*/d' | sort -u \
		| while IFS=$'\t' read categorie; do
		for color_mode in "${COLOR_MODE[@]}"; do
			if [ -z "$categorie" ]; then
				reminders_file="$TMP_DIR/$OUTPUT_FILEROOT.pango-$color_mode.rem"
			else
				reminders_file="$TMP_DIR/$OUTPUT_FILEROOT.$categorie.pango-$color_mode.rem"
			fi
			(
				echo "# < $SOURCE_DIR/$SOURCE_FILEROOT.rem"
				cat "$SOURCE_DIR/$SOURCE_FILEROOT.rem"
				echo "# /< $SOURCE_DIR/$SOURCE_FILEROOT.rem"
				echo

				if [ -n "$categorie" ]; then
					csvgrep -t -c 'Catégorie' -r '^('"$(quoteRe "$categorie")"'|\*.*)$' "$SOURCE_DIR/$SOURCE_FILEROOT.tsv"
				else
					csvformat -t "$SOURCE_DIR/$SOURCE_FILEROOT.tsv"
				fi \
					| csvcut -c 'Calendrier' | csvformat -T -E \
					| while IFS=$'\t' read calendrier; do
					cat "$TMP_DIR/$calendrier.ics.pango-$color_mode.rem"
				done
			) > "$reminders_file"
			echo "$reminders_file"
		done
	done
}


get_oldest_date_in_rem() {
	for rem_file in "$@"; do
		# from REM
		sed -n \
			-E 's/^REM\s+([A-Za-z]{3,10}\s+[0-9]{1,2}\s+[0-9]{4}|[0-9]{1,2}\s+[A-Za-z]{3,10}\s+[0-9]{4})(\s+.*|$)/\1/p' \
			< "$rem_file" \
			| while read date; do
			date -I -d "$date"
		done
		sed -n \
			-E 's/^REM\s+([0-9]{4}[-/][0-9]{2}[-/][0-9]{2})(\s+.*|$)/\1/p' \
			< "$rem_file"
		# from SATISFY
		sed -n \
			-E 's/.*\s+SATISFY\s+\[[^]]*\$T[<>=]+'"'"'([0-9]{4}-[0-9]{2}-[0-9]{2})'"'"'[^]]*\](\s+.*|$)/\1/p' \
			< "$rem_file"
	done | sort -u | head -1
}


months_since_date() {
	date_s="$(date -d "$1" +%s)"
	now_s="$(date +%s)"
	s="$(($now_s-$date_s))"
	months="$(($s/86400/30))"
	echo "$months"
}



##
# Run
##

check_tools

ls "$SOURCE_DIR"/*.tsv | while read source; do
	SOURCE_FILEROOT="${source##*/}"
	SOURCE_FILEROOT="${SOURCE_FILEROOT%.tsv}"
	OUTPUT_FILEROOT="$SOURCE_FILEROOT"

	download_icals

	generate_rems | generate_pdfs
done

if [ -n "$VIRTUAL_ENV" ]; then
	deactivate || true
fi

